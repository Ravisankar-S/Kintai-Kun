<%= turbo_stream.replace "user_table_body" do %>
  <tbody id="user_table_body">
    <% if @users.empty? %>
      <tr>
        <td colspan="6" class="py-16 text-center text-[14px] text-[#6B6860]"
            style="font-family: 'Geist', 'Inter', sans-serif;">
          <%= t('admin.no_users') %>
        </td>
      </tr>
    <% else %>
      <%= render partial: 'admin/users/user_row', collection: @users, as: :user %>
    <% end %>
  </tbody>
<% end %>
