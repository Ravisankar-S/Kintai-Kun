<%# Dashboard – exact replica of Stitch design (with memo on clock-out) %>

<%# Inject keyframe for orb scale-pulse %>
<% content_for :head do %>
<style>
  @keyframes orb-pulse {
    0%, 100% { transform: scale(1);    box-shadow: 0 0 0  0   rgba(74,158,114, 0.40); }
    50%       { transform: scale(1.08); box-shadow: 0 0 0  18px rgba(74,158,114, 0); }
  }
  .orb-pulsing { animation: orb-pulse 2.8s ease-in-out infinite; }
</style>
<% end %>

<div class="max-w-5xl mx-auto py-10 px-4">

  <%# Greeting %>
  <div class="mb-7">
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">
      <%= greeting_by_time %>, <%= current_user.name %>
    </h1>
    <p class="text-slate-500 text-sm mt-1">
      <%= format_date_bilingual(Date.current) %>
    </p>
  </div>

  <%# Two-column layout %>
  <div class="flex flex-col lg:flex-row gap-5 items-start">

    <%# ═══ LEFT COLUMN ═══ %>
    <div class="flex-1 min-w-0 space-y-4">

      <%# Status / Clock card %>
      <div class="bg-white/80 border border-[#e5ddd0] rounded-2xl shadow-sm p-6">
        <div class="flex items-start gap-7">

          <%# Orb %>
          <div class="flex-shrink-0 mt-1">
            <div class="w-[112px] h-[112px] rounded-full flex flex-col items-center
                        justify-center select-none
                        <%= @active_log ? 'bg-[#4a9e72] text-white orb-pulsing' : 'bg-[#d1cdc6] text-slate-500' %>">
              <% if @active_log %>
                <span class="text-[11px] font-medium opacity-75 tracking-wider mb-0.5">勤務中</span>
                <span class="text-[17px] font-bold leading-tight">
                  <%= l(@active_log.clocked_in_at, format: :clock) %>
                </span>
              <% else %>
                <span class="text-[11px] font-medium tracking-wider mb-0.5">未出勤</span>
                <span class="text-[17px] font-bold leading-tight">
                  <%= Time.current.strftime("%I:%M %p") %>
                </span>
              <% end %>
            </div>
          </div>

          <%# Status text + action %>
          <div class="flex-1 min-w-0">

            <% if @active_log %>
              <p class="text-[#4a9e72] font-semibold text-[15px]">Currently working</p>
              <p class="text-slate-500 text-sm mt-1">
                Since <%= l(@active_log.clocked_in_at, format: :clock) %>
              </p>
              <%
                elapsed  = ((Time.current - @active_log.clocked_in_at) / 60).to_i
                e_h = elapsed / 60; e_m = elapsed % 60
              %>
              <p class="text-slate-400 text-xs mt-0.5"><%= e_h %>h <%= e_m %>m elapsed</p>

              <%# Clock-out: direct button + optional memo via <details> %>
              <div class="mt-4">
                <%= form_with url: clock_out_path, method: :post,
                    id: "clock-out-form", class: "space-y-0" do |f| %>

                  <%# Hidden memo field – populated from the textarea below %>
                  <%= f.hidden_field :memo, id: "memo-hidden",
                      value: @active_log.memo %>

                  <%# Primary quick clock-out button %>
                  <%= f.submit "退勤する / Clock Out",
                      id: "clock-out-submit",
                      class: "cursor-pointer bg-[#c0392b] hover:bg-[#a93226]
                              text-white text-sm font-semibold
                              px-5 py-2 rounded-lg transition-colors shadow-sm" %>

                  <%# Optional memo expansion %>
                  <details class="mt-3 group" id="memo-details">
                    <summary class="list-none text-xs text-slate-400 hover:text-slate-600
                                    cursor-pointer select-none inline-flex items-center gap-1">
                      <svg class="w-3 h-3 transition-transform group-open:rotate-90"
                           viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
                      </svg>
                      Add a note
                    </summary>
                    <div class="mt-2">
                      <textarea id="memo-textarea" rows="2" maxlength="140"
                        placeholder="<%= t('dashboard.memo_placeholder') %>"
                        class="w-full rounded-xl border border-slate-200
                               px-3 py-2 text-sm bg-white
                               focus:outline-none focus:ring-2 focus:ring-[#4a9e72]/40
                               resize-none"
                        oninput="document.getElementById('memo-hidden').value = this.value"
                      ><%= @active_log.memo %></textarea>
                    </div>
                  </details>

                <% end %>
              </div>

            <% else %>
              <p class="text-slate-700 font-semibold text-[15px]">Not clocked in</p>
              <p class="text-slate-400 text-sm mt-1">Ready to start your shift?</p>

              <div class="mt-4">
                <%= form_with url: clock_in_path, method: :post,
                    id: "clock-in-form", class: "space-y-0" do |f| %>

                  <%= f.hidden_field :memo, id: "clock-in-memo-hidden" %>

                  <%= f.submit t("dashboard.clock_in_button"),
                      class: "cursor-pointer bg-[#4a9e72] hover:bg-[#3d8a61]
                              text-white text-sm font-semibold
                              px-5 py-2 rounded-lg transition-colors shadow-sm" %>

                  <details class="mt-3 group">
                    <summary class="list-none text-xs text-slate-400 hover:text-slate-600
                                    cursor-pointer select-none inline-flex items-center gap-1">
                      <svg class="w-3 h-3 transition-transform group-open:rotate-90"
                           viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
                      </svg>
                      Add a note
                    </summary>
                    <div class="mt-2">
                      <textarea rows="2" maxlength="140"
                        placeholder="<%= t('dashboard.memo_placeholder') %>"
                        class="w-full rounded-xl border border-slate-200
                               px-3 py-2 text-sm bg-white
                               focus:outline-none focus:ring-2 focus:ring-[#4a9e72]/40
                               resize-none"
                        oninput="document.getElementById('clock-in-memo-hidden').value = this.value"
                      ></textarea>
                    </div>
                  </details>

                <% end %>
              </div>
            <% end %>

          </div>
        </div>
      </div>

      <%# Zangyo alert – level 1 %>
      <% if @zangyo_level == 1 %>
        <%= render "shared/zangyo_alert" %>
      <% end %>

      <%# Work Rhythm heatmap %>
      <%= render "shared/heatmap" %>

    </div><%# /LEFT %>

    <%# ═══ RIGHT COLUMN ═══ %>
    <div class="w-full lg:w-[272px] flex-shrink-0 space-y-3">

      <%# Zangyo alert – level 2 %>
      <% if @zangyo_level == 2 %>
        <%= render "shared/zangyo_alert" %>
      <% end %>

      <%# 2 × 2 stat grid %>
      <div class="grid grid-cols-2 gap-3">

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-4 shadow-sm">
          <p class="text-[11px] text-slate-500 mb-2 font-medium">Days Worked</p>
          <p class="text-[28px] font-bold text-slate-900 leading-none">
            <%= @weekly_summary[:days_worked] %>
          </p>
          <p class="text-[11px] text-slate-400 mt-1">This week</p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-4 shadow-sm">
          <p class="text-[11px] text-slate-500 mb-2 font-medium">Total Hours</p>
          <p class="text-[28px] font-bold text-slate-900 leading-none">
            <%= @weekly_summary[:total_minutes] / 60 %>h
          </p>
          <p class="text-[11px] text-slate-400 mt-1">Mon – today</p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-4 shadow-sm">
          <p class="text-[11px] text-slate-500 mb-2 font-medium">Daily Average</p>
          <%
            avg_h = @weekly_summary[:avg_minutes] / 60
            avg_m = @weekly_summary[:avg_minutes] % 60
          %>
          <p class="text-[22px] font-bold text-slate-900 leading-none">
            <%= avg_h %>h <%= avg_m.to_s.rjust(2,"0") %>m
          </p>
          <p class="text-[11px] text-slate-400 mt-1">Worked days only</p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-4 shadow-sm">
          <p class="text-[11px] text-slate-500 mb-2 font-medium">Overtime Days</p>
          <p class="text-[28px] font-bold leading-none
                    <%= @weekly_summary[:overtime_days] > 0 ? 'text-amber-500' : 'text-slate-900' %>">
            <%= @weekly_summary[:overtime_days] %>
          </p>
          <p class="text-[11px] text-slate-400 mt-1">This week</p>
        </div>

      </div><%# /grid %>

    </div><%# /RIGHT %>

  </div><%# /two-col %>
</div>