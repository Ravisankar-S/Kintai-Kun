<div class="max-w-6xl mx-auto py-10 px-4">

  <!-- Greeting Section -->
  <div class="mb-8">

    <h1 class="text-4xl font-bold tracking-tight text-slate-800">
      <%= greeting_by_time %>,
      <span class="text-emerald-600">
        <%= current_user.name %>
      </span>
    </h1>

    <p class="text-slate-500 mt-2 text-sm">
      <%= l(Date.current, format: :dashboard) %>
    </p>

  </div>

  <!-- Zangyo Alert -->
  <%= render "shared/zangyo_alert" %>

  <!-- Main Status Card -->
  <div class="bg-white border border-slate-200
              rounded-3xl shadow-sm p-8 mb-8">

    <div class="flex items-start justify-between">

      <div>

        <% if @active_log %>

          <p class="text-emerald-600 font-semibold text-lg">
            🟢 <%= t("dashboard.working") %>
          </p>

          <p class="text-slate-500 mt-2">
            <%= t("dashboard.since") %>
            <span class="font-medium text-slate-700">
              <%= l(@active_log.clocked_in_at, format: :clock) %>
            </span>
          </p>

        <% else %>

          <p class="text-slate-700 font-semibold text-lg">
            ⚪ <%= t("dashboard.not_working") %>
          </p>

          <p class="text-slate-500 mt-2">
            <%= t("dashboard.ready") %>
          </p>

        <% end %>

      </div>

      <div>

        <% if @active_log %>

          <%= form_with url: clock_out_path,
              method: :post,
              class: "space-y-4" do |f| %>

            <%= f.text_area :memo,
                value: @active_log.memo,
                placeholder: "Update shift memo...",
                maxlength: 140,
                rows: 3,
                class: "
                  w-full rounded-2xl border border-slate-300
                  px-4 py-3 text-sm
                  focus:outline-none focus:ring-2
                  focus:ring-rose-400
                " %>

            <%= f.submit "Clock Out",
                class: "
                  bg-rose-500 hover:bg-rose-600
                  text-white px-8 py-3 rounded-2xl
                  font-semibold transition shadow-sm
                " %>

          <% end %>

        <% else %>

          <%= form_with url: clock_in_path,
              method: :post,
              class: "space-y-4" do |f| %>

            <%= f.text_area :memo,
                placeholder: "Optional shift memo...",
                maxlength: 140,
                rows: 3,
                class: "
                  w-full rounded-2xl border border-slate-300
                  px-4 py-3 text-sm
                  focus:outline-none focus:ring-2
                  focus:ring-emerald-400
                " %>

            <%= f.submit "Clock In",
                class: "
                  bg-emerald-500 hover:bg-emerald-600
                  text-white px-8 py-3 rounded-2xl
                  font-semibold transition shadow-sm
                " %>

          <% end %>

        <% end %>

      </div>

    </div>

  </div>

  <!-- Analytics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Today Card -->
    <div class="bg-white border border-slate-200
                rounded-3xl shadow-sm p-6">

      <p class="text-sm text-slate-500 mb-3">
        <%= t("summary.today") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(@today_minutes) %>
      </p>

      <div class="mt-4 h-2 bg-slate-100 rounded-full overflow-hidden">

        <div class="h-full bg-emerald-500 rounded-full"
             style="width: <%= [(@today_minutes / 480.0 * 100), 100].min %>%">
        </div>

      </div>

      <p class="text-xs text-slate-400 mt-2">
        <%= t("dashboard.today_target", hours: 8) %>
      </p>

    </div>

    <!-- Week Card -->
    <div class="bg-white border border-slate-200
                rounded-3xl shadow-sm p-6">

      <p class="text-sm text-slate-500 mb-3">
        <%= t("summary.week") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(@week_minutes) %>
      </p>

      <p class="text-sm text-slate-500 mt-4">
        <%= t("dashboard.week_total_note") %>
      </p>

    </div>

  </div>

  <!-- Weekly Summary -->
<div class="mt-10">

  <div class="flex items-center justify-between mb-5">

    <h2 class="text-2xl font-semibold text-slate-800">
      <%= t("summary.weekly_summary") %>
    </h2>

    <p class="text-sm text-slate-500">
      <%= t("dashboard.week_range") %>
    </p>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Days Worked -->
    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.days_worked") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= @weekly_summary[:days_worked] %>
      </p>

    </div>

    <!-- Total Hours -->
    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.total_hours") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(
              @weekly_summary[:total_minutes]
            ) %>
      </p>

    </div>

    <!-- Average -->
    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.average_per_day") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(
              @weekly_summary[:average_minutes]
            ) %>
      </p>

    </div>

    <!-- Overtime -->
    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.overtime_days") %>
      </p>

      <p class="text-4xl font-bold text-rose-500">
        <%= @weekly_summary[:overtime_days] %>
      </p>

    </div>

  </div>

</div>

<%= render "shared/heatmap" %>

</div>