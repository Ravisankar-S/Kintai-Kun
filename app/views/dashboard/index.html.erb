<%# Dashboard – exact replica of Stitch design (with memo on clock-out) %>

<%# Inject keyframe for orb scale-pulse %>
<% content_for :head do %>
<style>
  @keyframes orb-pulse {
    0%, 100% { transform: scale(1);    box-shadow: 0 0 0  0   rgba(74,158,114, 0.40); }
    50%       { transform: scale(1.08); box-shadow: 0 0 0  18px rgba(74,158,114, 0); }
  }
  .orb-pulsing { animation: orb-pulse 2.8s ease-in-out infinite; }
</style>
<% end %>

<div class="max-w-5xl mx-auto py-10 px-4" data-controller="modal">

  <%# Greeting %>
  <div class="mb-7">
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">
      <%= greeting_by_time %>, <%= current_user.name %>
    </h1>
    <p class="text-slate-500 text-sm mt-1">
      <%= format_date_bilingual(Date.current) %>
    </p>
  </div>

  <%# Two-column layout %>
  <div class="flex flex-col lg:flex-row gap-5 items-start">

    <%# ═══ LEFT COLUMN ═══ %>
    <div class="flex-1 min-w-0 space-y-4">

      <%# Status / Clock card %>
      <div class="bg-white/80 border border-[#e5ddd0] rounded-2xl shadow-sm p-6">
        <div class="flex items-start gap-7">

          <%# Orb %>
          <div class="flex-shrink-0 mt-1" 
               <%= "data-controller='timer' data-timer-start-value='#{@active_log.clocked_in_at.iso8601}' data-timer-break-minutes-value='#{@active_log.break_minutes}' data-timer-on-break-value='#{@active_log.on_break?}'".html_safe if @active_log %>>
            <div data-timer-target="indicator" class="w-[112px] h-[112px] rounded-full flex flex-col items-center
                        justify-center select-none transition-colors duration-300
                        <%= @active_log ? (@active_log.on_break? ? 'bg-amber-500 text-white' : 'bg-[#4a9e72] text-white orb-pulsing') : 'bg-[#d1cdc6] text-slate-500' %>">
              <% if @active_log %>
                <span class="text-[11px] font-medium opacity-75 tracking-wider mb-0.5 uppercase"><%= @active_log.on_break? ? t('dashboard.status_on_break') : t('dashboard.orb_working') %></span>
                <span class="text-[17px] font-bold leading-tight font-mono tracking-wider" data-timer-target="display">
                  --:--:--
                </span>
              <% else %>
                <span class="text-[11px] font-medium tracking-wider mb-0.5 uppercase"><%= t('dashboard.orb_idle') %></span>
                <span class="text-[17px] font-bold leading-tight font-mono">
                  <%= Time.current.strftime("%I:%M %p") %>
                </span>
              <% end %>
            </div>
          </div>

          <%# Status text + action %>
          <div class="flex-1 min-w-0">

            <% if @active_log %>
              <p class="font-semibold text-[15px] <%= @active_log.on_break? ? 'text-amber-500' : 'text-[#4a9e72]' %>">
                <%= @active_log.on_break? ? t('dashboard.status_on_break') : t('dashboard.status_working') %>
              </p>
              <p class="text-slate-500 text-sm mt-1">
                <%= t('dashboard.since', time: l(@active_log.clocked_in_at, format: :clock)) %>
              </p>
              <% if @active_log.break_minutes > 0 %>
                <p class="text-slate-400 text-xs mt-0.5">Total break: <%= @active_log.break_minutes %>m</p>
              <% end %>

              <%# Clock-out and Break buttons %>
              <div class="mt-4 flex flex-wrap gap-2">
                <% if @active_log.on_break? %>
                  <%= button_to t("dashboard.resume_work_button"), resume_work_path, method: :post, class: "cursor-pointer bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors shadow-sm" %>
                <% else %>
                  <%= button_to t("dashboard.take_break_button"), take_break_path, method: :post, class: "cursor-pointer bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold px-5 py-2 rounded-lg transition-colors shadow-sm" %>
                <% end %>

                <button type="button" data-action="click->modal#open"
                    class="cursor-pointer bg-[#c0392b] hover:bg-[#a93226] text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors shadow-sm">
                  <%= t("dashboard.clock_out_button") %>
                </button>
              </div>

            <% else %>
              <p class="text-slate-700 font-semibold text-[15px]"><%= t('dashboard.status_idle') %></p>
              <p class="text-slate-400 text-sm mt-1"><%= t('dashboard.ready_to_start') %></p>

              <div class="mt-4">
                <button type="button" data-action="click->modal#open"
                    class="cursor-pointer bg-[#4a9e72] hover:bg-[#3d8a61] text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors shadow-sm">
                  <%= t("dashboard.clock_in_button") %>
                </button>
              </div>
            <% end %>

          </div>
        </div>
      </div>

      <%# Zangyo alert – level 1 %>
      <% if @zangyo_level == 1 %>
        <%= render "shared/zangyo_alert" %>
      <% end %>

      <%# Work Rhythm heatmap %>
      <%= render "shared/heatmap" %>

    </div><%# /LEFT %>

    <%# ═══ RIGHT COLUMN ═══ %>
    <div class="w-full lg:w-[320px] flex-shrink-0 space-y-4">

      <%# Zangyo alert – level 2 %>
      <% if @zangyo_level == 2 %>
        <%= render "shared/zangyo_alert" %>
      <% end %>

      <%# 2 × 2 stat grid %>
      <div class="grid grid-cols-2 gap-4">

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-5 shadow-sm">
          <p class="text-[12px] text-slate-500 mb-2 font-medium"><%= t('summary.days_worked') %></p>
          <p class="text-[32px] font-bold text-slate-900 leading-none">
            <%= @weekly_summary[:days_worked] %>
          </p>
          <p class="text-[12px] text-slate-400 mt-1.5"><%= t('summary.this_week') %></p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-5 shadow-sm">
          <p class="text-[12px] text-slate-500 mb-2 font-medium"><%= t('summary.total_hours') %></p>
          <p class="text-[32px] font-bold text-slate-900 leading-none">
            <%= @weekly_summary[:total_minutes] / 60 %>h
          </p>
          <p class="text-[12px] text-slate-400 mt-1.5"><%= t('summary.mon_today') %></p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-5 shadow-sm">
          <p class="text-[12px] text-slate-500 mb-2 font-medium"><%= t('summary.avg_hours') %></p>
          <%
            avg_h = @weekly_summary[:avg_minutes] / 60
            avg_m = @weekly_summary[:avg_minutes] % 60
          %>
          <p class="text-[24px] font-bold text-slate-900 leading-none">
            <%= avg_h %>h <%= avg_m.to_s.rjust(2,"0") %>m
          </p>
          <p class="text-[12px] text-slate-400 mt-1.5"><%= t('summary.worked_days_only') %></p>
        </div>

        <div class="bg-white/80 border border-[#e5ddd0] rounded-xl p-5 shadow-sm">
          <p class="text-[12px] text-slate-500 mb-2 font-medium"><%= t('summary.overtime_days') %></p>
          <p class="text-[32px] font-bold leading-none
                    <%= @weekly_summary[:overtime_days] > 0 ? 'text-amber-500' : 'text-slate-900' %>">
            <%= @weekly_summary[:overtime_days] %>
          </p>
          <p class="text-[12px] text-slate-400 mt-1.5"><%= t('summary.this_week') %></p>
        </div>

      </div><%# /grid %>

    </div><%# /RIGHT %>

  </div><%# /two-col %>

  <%# Modal for Clock In/Out %>
  <div data-modal-target="dialog" class="hidden relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/10 backdrop-blur-sm transition-opacity" data-action="click->modal#closeBackground"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0" data-action="click->modal#closeBackground">
        <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">
          <div class="bg-white px-6 pb-6 pt-6">
            <h3 class="text-lg font-semibold leading-6 text-slate-900 mb-4 font-serif">
              <%= @active_log ? t('dashboard.clock_out_button') : t('dashboard.clock_in_button') %>
            </h3>
            
            <%= form_with url: @active_log ? clock_out_path : clock_in_path, method: :post, id: "clock-form", class: "space-y-4" do |f| %>
              <div>
                <label for="memo" class="block text-sm font-medium leading-6 text-slate-700"><%= t('dashboard.memo_label') %></label>
                <div class="mt-2">
                  <%= f.text_area :memo, id: "memo", rows: 3, 
                      value: @active_log&.memo,
                      placeholder: t('dashboard.memo_placeholder'),
                      class: "block w-full rounded-md border-0 px-3 py-2 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#4a9e72] sm:text-sm sm:leading-6 resize-none" %>
                </div>
              </div>
              
              <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                <%= f.submit @active_log ? t('dashboard.clock_out_button') : t('dashboard.clock_in_button'), 
                    class: "cursor-pointer inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm sm:col-start-2 #{ @active_log ? 'bg-[#c0392b] hover:bg-[#a93226]' : 'bg-[#4a9e72] hover:bg-[#3d8a61]' }" %>
                <button type="button" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:col-start-1 sm:mt-0" data-action="click->modal#close"><%= t('dashboard.cancel') %></button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>