<div class="max-w-6xl mx-auto py-10 px-4">

  <!-- Greeting Section -->
  <div class="mb-8">

    <h1 class="text-4xl font-bold tracking-tight text-slate-800">
      <%= greeting_by_time %>,
      <span class="text-emerald-600">
        <%= current_user.name %>
      </span>
    </h1>

    <p class="text-slate-500 mt-2 text-sm">
      <%= format_date_bilingual(Date.current) %>
    </p>

  </div>

  <!-- Zangyo Alert (Level 2 at top) -->
  <% if @zangyo_level == 2 %>
    <%= render "shared/zangyo_alert" %>
  <% end %>

  <!-- Main Status Card -->
  <div class="bg-white border border-slate-200
              rounded-3xl shadow-sm p-8 mb-8">

    <div class="flex items-start justify-between">

      <div>

        <% if @active_log %>

          <p class="text-emerald-600 font-semibold text-lg">
            🟢 <%= t("dashboard.status_working") %>
          </p>

          <p class="text-slate-500 mt-2">
            <%= t("dashboard.already_clocked_in",
                  time: l(@active_log.clocked_in_at, format: :clock)) %>
          </p>

        <% else %>

          <p class="text-slate-700 font-semibold text-lg">
            ⚪ <%= t("dashboard.status_idle") %>
          </p>

        <% end %>

      </div>

      <div>

        <% if @active_log %>

          <details class="space-y-4">
            <summary class="list-none bg-rose-500 hover:bg-rose-600
                             text-white px-8 py-3 rounded-2xl
                             font-semibold transition shadow-sm
                             cursor-pointer text-center">
              <%= t("dashboard.clock_out_button") %>
            </summary>

            <%= form_with url: clock_out_path,
                method: :post,
                class: "space-y-4" do |f| %>

              <%= f.text_area :memo,
                  value: @active_log.memo,
                  placeholder: t("dashboard.memo_placeholder"),
                  maxlength: 140,
                  rows: 3,
                  class: "
                    w-full rounded-2xl border border-slate-300
                    px-4 py-3 text-sm
                    focus:outline-none focus:ring-2
                    focus:ring-rose-400
                  " %>

              <%= f.submit t("dashboard.end_shift"),
                  class: "
                    bg-rose-500 hover:bg-rose-600
                    text-white px-8 py-3 rounded-2xl
                    font-semibold transition shadow-sm
                  " %>

            <% end %>
          </details>

        <% else %>

          <details class="space-y-4">
            <summary class="list-none bg-emerald-500 hover:bg-emerald-600
                             text-white px-8 py-3 rounded-2xl
                             font-semibold transition shadow-sm
                             cursor-pointer text-center">
              <%= t("dashboard.clock_in_button") %>
            </summary>

            <%= form_with url: clock_in_path,
                method: :post,
                class: "space-y-4" do |f| %>

              <%= f.text_area :memo,
                  placeholder: t("dashboard.memo_placeholder"),
                  maxlength: 140,
                  rows: 3,
                  class: "
                    w-full rounded-2xl border border-slate-300
                    px-4 py-3 text-sm
                    focus:outline-none focus:ring-2
                    focus:ring-emerald-400
                  " %>

              <%= f.submit t("dashboard.start_shift"),
                  class: "
                    bg-emerald-500 hover:bg-emerald-600
                    text-white px-8 py-3 rounded-2xl
                    font-semibold transition shadow-sm
                  " %>

            <% end %>
          </details>

        <% end %>

      </div>

    </div>

  </div>

  <!-- Analytics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Today Card -->
    <div class="bg-white border border-slate-200
                rounded-3xl shadow-sm p-6">

      <p class="text-sm text-slate-500 mb-3">
        <%= t("dashboard.today_hours") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(@today_minutes) %>
      </p>

      <div class="mt-4 h-2 bg-slate-100 rounded-full overflow-hidden">

        <div class="h-full bg-emerald-500 rounded-full"
             style="width: <%= [(@today_minutes / 480.0 * 100), 100].min %>%">
        </div>

      </div>

      <p class="text-xs text-slate-400 mt-2">
        <%= t("dashboard.target_hours", hours: 8) %>
      </p>

    </div>

    <!-- Week Card -->
    <div class="bg-white border border-slate-200
                rounded-3xl shadow-sm p-6">

      <p class="text-sm text-slate-500 mb-3">
        <%= t("dashboard.week_hours") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(@week_minutes) %>
      </p>

    </div>

  </div>

  <!-- Zangyo Alert (Level 1 between status and heatmap) -->
  <% if @zangyo_level == 1 %>
    <%= render "shared/zangyo_alert" %>
  <% end %>

  <%= render "shared/heatmap" %>

  <!-- Weekly Summary Cards -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">

    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.days_worked") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= @weekly_summary[:days_worked] %>
      </p>

    </div>

    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.total_hours") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(
              @weekly_summary[:total_minutes]
            ) %>
      </p>

    </div>

    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.avg_hours") %>
      </p>

      <p class="text-4xl font-bold text-slate-800">
        <%= minutes_to_hm(
              @weekly_summary[:avg_minutes]
            ) %>
      </p>

    </div>

    <div class="bg-white border border-slate-200
                rounded-3xl p-6 shadow-sm">

      <p class="text-sm text-slate-500 mb-2">
        <%= t("summary.overtime_days") %>
      </p>

      <p class="text-4xl font-bold text-rose-500">
        <%= @weekly_summary[:overtime_days] %>
      </p>

    </div>

  </div>

</div>