<div class="min-h-[calc(100vh-120px)] flex flex-col items-center justify-center px-4 py-10">
  <div class="text-center mb-8">
    <h1 class="font-serif text-3xl text-slate-900"><%= t("app_name") %></h1>
  </div>

  <div class="w-full max-w-md bg-white/80 border border-[#e2d9cb] rounded-3xl shadow-[0_20px_40px_-30px_rgba(60,50,30,0.35)] p-8">
    <div class="mb-6">
      <h2 class="font-serif text-2xl text-slate-900"><%= t('auth.create_account_title') %></h2>
      <p class="text-sm text-slate-600 mt-1"><%= t('auth.join_team') %></p>
    </div>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { class: "space-y-5" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, t('auth.name'), class: "block text-sm text-slate-600 mb-2" %>
        <%= f.text_field :name,
            autofocus: true,
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <div>
        <%= f.label :email, t('auth.email'), class: "block text-sm text-slate-600 mb-2" %>
        <%= f.email_field :email,
            autocomplete: "email",
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <%= f.label :password, t('auth.password'), class: "block text-sm text-slate-600 mb-2" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-slate-500">
              <%= @minimum_password_length %> <%= t('auth.characters_minimum') %>
            </span>
          <% end %>
        </div>

        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <div>
        <%= f.label :password_confirmation, t('auth.password_confirmation'),
            class: "block text-sm text-slate-600 mb-2" %>

        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <%= f.submit t('auth.sign_up'),
          class: "w-full bg-emerald-800 hover:bg-emerald-900 text-white py-3 rounded-2xl font-semibold shadow-sm transition" %>

      <p class="text-xs text-slate-500">
        <%= t('auth.responsibility_text') %>
      </p>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to t('auth.already_have_account'),
          new_session_path(resource_name),
          class: "text-sm text-emerald-700 hover:text-emerald-800" %>
    </div>
  </div>
</div>