<div class="min-h-[calc(100vh-120px)] flex flex-col items-center justify-center px-4 py-10">
  <div class="text-center mb-8">
    <h1 class="font-serif text-3xl text-slate-900"><%= t("app_name") %></h1>
  </div>

  <div class="w-full max-w-md bg-white/80 border border-[#e2d9cb] rounded-3xl shadow-[0_20px_40px_-30px_rgba(60,50,30,0.35)] p-8">
    <div class="mb-6">
      <h2 class="font-serif text-2xl text-slate-900">Welcome back</h2>
      <p class="text-sm text-slate-600 mt-1">Sign in to your account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm text-slate-600 mb-2" %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <%= f.label :password, class: "block text-sm text-slate-600 mb-2" %>
          <%= link_to "Forgot password?",
              new_password_path(resource_name),
              class: "text-xs text-emerald-700 hover:text-emerald-800" %>
        </div>
        <%= f.password_field :password,
            autocomplete: "current-password",
            class: "w-full rounded-2xl border border-[#d8cfc2] bg-[#f9f5ee] px-4 py-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-200" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-[#d8cfc2] text-emerald-700 focus:ring-emerald-200" %>
          <%= f.label :remember_me, class: "text-sm text-slate-600" %>
        </div>
      <% end %>

      <%= f.submit "Sign In",
          class: "w-full bg-emerald-800 hover:bg-emerald-900 text-white py-3 rounded-2xl font-semibold shadow-sm transition" %>
    <% end %>

    <div class="flex items-center gap-3 my-6">
      <div class="h-px bg-[#e2d9cb] flex-1"></div>
      <span class="text-xs uppercase tracking-widest text-slate-500">or</span>
      <div class="h-px bg-[#e2d9cb] flex-1"></div>
    </div>

    <%= link_to "Create an account",
        new_registration_path(resource_name),
        class: "block text-center text-sm text-emerald-700 hover:text-emerald-800" %>
  </div>
</div>
