<div class="flex items-center justify-center min-h-[calc(100vh-120px)] px-4">
  <div class="bg-white border border-[#E8E6E1] p-10 rounded-2xl w-full max-w-[400px] text-center"
       style="box-shadow: 0 4px 24px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);">
    
    <h1 class="text-[32px] text-[#1A1A18] mb-2"
        style="font-family: 'Shippori Mincho', serif; font-weight: 500;">
      <%= t("app_name") %>
    </h1>

    <p class="text-[14px] text-[#6B6860] mb-8"
       style="font-family: 'Geist', 'Inter', sans-serif;">
      <%= t("app_tagline") %>
    </p>

    <div class="flex flex-col gap-3">
      <%= link_to t("auth.sign_up"), new_user_registration_path,
          class: "w-full flex items-center justify-center h-[48px] bg-[#2D6A4F] text-white rounded-lg text-[14px] font-semibold transition-all duration-200 hover:bg-[#38855F] hover:-translate-y-[1px]",
          style: "font-family: 'Geist', 'Inter', sans-serif; box-shadow: 0 2px 8px rgba(45,106,79,0.25);" %>

      <%= link_to t("auth.log_in"), new_user_session_path,
          class: "w-full flex items-center justify-center h-[48px] bg-white border border-[#E8E6E1] text-[#1A1A18] rounded-lg text-[14px] font-medium transition-all duration-200 hover:bg-[#FAFAF8] hover:-translate-y-[1px]",
          style: "font-family: 'Geist', 'Inter', sans-serif; box-shadow: 0 1px 2px rgba(0,0,0,0.03);" %>
    </div>
    
  </div>

  <%# Info Tooltip / Card %>
  <div data-controller="info-card"
       class="absolute right-4 bottom-4 md:static md:ml-8 bg-emerald-50 border border-emerald-200 rounded-2xl shadow-lg transition-all duration-300 overflow-hidden w-64 p-4 z-50 text-left"
       data-action="click->info-card#expand">
    
    <%# Expanded Content %>
    <div data-info-card-target="content" class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-emerald-800">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-semibold text-sm">Demo Access</span>
      </div>
      <p class="text-[13px] text-emerald-700 leading-relaxed" style="font-family: 'Geist', sans-serif;">
        Preset credentials available for demo.<br>
        Click on <strong>Log In</strong> button.
      </p>
    </div>

    <%# Collapsed 'i' icon (hidden initially) %>
    <div data-info-card-target="icon" class="hidden">
      <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
  </div>

</div>