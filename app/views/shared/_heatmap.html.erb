<div class="bg-white border border-slate-200
            rounded-3xl p-6 shadow-sm mt-10">

  <div class="flex items-center justify-between mb-5">

    <h2 class="text-2xl font-semibold text-slate-800">
      <%= t("heatmap.title") %>
    </h2>

  </div>

  <div class="overflow-x-auto">

    <div class="flex gap-[3px] min-w-max">

      <% start_date = 83.days.ago.to_date.beginning_of_week(:monday) %>

      <% 12.times do |week| %>

        <div class="flex flex-col gap-[3px]">

          <% 7.times do |day| %>

            <% current_date =
                start_date + (week * 7) + day %>

            <% minutes =
                @heatmap_data[current_date] %>

            <% tooltip_text = if minutes.present? && minutes.positive?
              hours = minutes / 60
              mins = minutes % 60
              t("heatmap.tooltip",
                date: l(current_date, format: :table),
                hours: hours,
                minutes: mins
              )
            else
              no_log_label = t("heatmap.no_log")
              "#{l(current_date, format: :table)}: #{no_log_label}"
            end %>

            <div
              class="w-4 h-4 rounded-sm
                     hover:scale-125 transition-transform"
              style="
                background-color:
                <%= heatmap_color(minutes) %>;
              "
              title="
                <%= tooltip_text %>
              ">
            </div>

          <% end %>

        </div>

      <% end %>

    </div>

  </div>

</div>