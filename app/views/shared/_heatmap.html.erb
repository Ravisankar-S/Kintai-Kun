<%#
  Work Rhythm Heatmap
  Layout matches Stitch spec:
    - "Work Rhythm" title
    - Month labels across top (Mar / Apr / May)
    - Row labels on left: M / W / F  (Mon, Wed, Fri)
    - Columns = weeks, Rows = days (Mon=0 … Sun=6), only M/W/F labelled
    - 12 weeks shown (~84 days back)
    - Cell colours from heatmap_color helper
%>

<%
  num_weeks   = 16
  start_date  = 83.days.ago.to_date.beginning_of_week(:monday)
  day_labels  = %w[M T W T F S S]   # Mon-Sun
  show_label  = [true, false, true, false, true, false, false]  # M W F only

  # Build month-label positions: { col_index => "MonAbbrev" }
  month_headers = {}
  num_weeks.times do |w|
    week_start = start_date + (w * 7)
    # Label the column when a new month begins (first week of that month)
    month_headers[w] = week_start.strftime("%b") if w == 0 || week_start.day <= 7
  end
%>

<div class="bg-[#FCFCFA] border border-[#e5ddd0] rounded-2xl shadow-sm p-6 mt-0">

  <h2 class="text-2xl text-[#1A1A18] mb-6" style="font-family: 'DM Serif Display', serif;"><%= t('heatmap.title') %></h2>

  <div class="overflow-x-auto">
    <div class="inline-block min-w-max">

      <%# ── Month labels row ── %>
      <div class="flex mb-2 ml-8"><%# ml-8 aligns with the day-label gutter %>
        <% num_weeks.times do |w| %>
          <div class="w-[16px] mr-1.5 text-[12px] text-slate-500 text-left leading-none select-none">
            <%= month_headers[w] %>
          </div>
        <% end %>
      </div>

      <%# ── Grid: day-label column + week columns ── %>
      <div class="flex gap-0">

        <%# Day-label column %>
        <div class="flex flex-col gap-1.5 mr-3 justify-start mt-[1px]">
          <% 7.times do |d| %>
            <div class="h-[16px] w-5 flex items-center">
              <% if show_label[d] %>
                <span class="text-[12px] text-slate-500 leading-none select-none">
                  <%= day_labels[d] %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Week columns %>
        <% num_weeks.times do |w| %>
          <div class="flex flex-col gap-1.5 mr-1.5">
            <% 7.times do |d| %>
              <%
                current_date = start_date + (w * 7) + d
                minutes      = @heatmap_data[current_date]

                tooltip_text = if minutes.present? && minutes.positive?
                  h = minutes / 60
                  m = minutes % 60
                  t("heatmap.tooltip",
                    date: l(current_date, format: :table),
                    hours: h,
                    minutes: m)
                else
                  "#{l(current_date, format: :table)}: #{t('heatmap.no_log')}"
                end

                # Build colour – future dates get a very light placeholder
                cell_color = if current_date > Date.current
                  "#F0EDE8"
                else
                  heatmap_color(minutes)
                end
              %>
              <div
                class="w-[16px] h-[16px] rounded-[4px] hover:ring-2 hover:ring-slate-400 hover:ring-offset-1 transition-all cursor-pointer"
                style="background-color: <%= cell_color %>;"
                data-controller="tooltip"
                data-tooltip-content-value="<%= tooltip_text %>"
              ></div>
            <% end %>
          </div>
        <% end %>

      </div><%# /grid %>

      <%# ── Legend ── %>
      <div class="flex items-center gap-2 mt-5 ml-8">
        <span class="text-[12px] text-slate-500">Less</span>
        <% [nil, 60, 240, 420, 481].each do |mins| %>
          <div class="w-[14px] h-[14px] rounded-[3px]"
               style="background-color: <%= heatmap_color(mins) %>;"></div>
        <% end %>
        <span class="text-[12px] text-slate-500">More</span>
      </div>

    </div><%# /inline-block %>
  </div><%# /overflow-x-auto %>

</div>