<% if @zangyo_level == 1 %>

  <div class="bg-amber-100 border border-amber-400
              text-amber-900 px-6 py-4 rounded-2xl mb-6">

    <p class="font-semibold">
      ⚠ <%= t("zangyo.level1_message") %>
    </p>


  </div>

<% elsif @zangyo_level == 2 %>

  <div class="bg-red-100 border border-red-400
              text-red-900 px-6 py-4 rounded-2xl mb-6">

    <p class="font-semibold">
      🚨 <%= t("zangyo.level2_message") %>
      <span
        class="ml-2 inline-flex items-center justify-center
               w-5 h-5 rounded-full border border-red-300
               text-xs font-bold cursor-help"
        title="<%= t("zangyo.tooltip") %>">
        ⓘ
      </span>
    </p>


  </div>

<% end %>