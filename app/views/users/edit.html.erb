<div class="max-w-3xl mx-auto py-10 px-4">

  <div class="mb-8">

    <h1 class="text-3xl font-bold text-slate-800">
      <%= t("users.profile_title") %>
    </h1>

  </div>

  <div class="bg-white border border-slate-200
              rounded-3xl shadow-sm p-8">

    <%= form_with model: @user,
        url: update_profile_path,
        method: :patch,
        html: {
          class: "space-y-6",
          multipart: true
        } do |f| %>

      <!-- Avatar -->
      <div class="flex items-center gap-6">

        <%= avatar_for(
          @user,
          size: 80,
          class_name: "ring-2 ring-slate-200"
        ) %>

        <div class="flex-1">

          <%= f.label :avatar,
            t("users.avatar"),
              class: "block text-sm font-medium
                      text-slate-700 mb-2" %>

          <%= f.file_field :avatar,
              accept: "image/*",
              class: "
                block w-full text-sm text-slate-600
                file:mr-4 file:py-2 file:px-4
                file:rounded-xl file:border-0
                file:text-sm file:font-semibold
                file:bg-slate-100 file:text-slate-700
                hover:file:bg-slate-200
              " %>

          <p class="text-xs text-slate-500 mt-2">
            <%= t("users.avatar_hint") %>
          </p>

        </div>

        <% if @user.avatar.attached? %>
          <div class="self-start">
            <%= link_to destroy_avatar_path,
              data: {
                turbo_method: :delete,
                turbo_confirm: t("users.avatar_remove_confirm")
              },
              class: "
                inline-flex items-center justify-center
                rounded-xl border border-rose-200
                text-rose-600 hover:text-rose-700
                hover:border-rose-300 hover:bg-rose-50
                w-10 h-10
              " do %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="w-5 h-5"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-7 4v6m4-6v6m4-6v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" />
              </svg>
              <span class="sr-only"><%= t("users.avatar_remove") %></span>
            <% end %>
          </div>
        <% end %>

      </div>

      <!-- Name -->
      <div>

        <%= f.label :name,
          t("users.name"),
            class: "block text-sm font-medium
                    text-slate-700 mb-2" %>

        <%= f.text_field :name,
            class: "
              w-full rounded-2xl border border-slate-300
              px-4 py-3
            " %>

      </div>

      <!-- Work Mode -->
      <div>

        <label class="block text-sm font-medium
                      text-slate-700 mb-3">

          <%= t("users.work_mode") %>

        </label>

        <div class="flex gap-6">

          <label class="flex items-center gap-2">

            <%= f.radio_button :work_mode, "fixed" %>

            <span><%= t("users.work_mode_fixed") %></span>

          </label>

          <label class="flex items-center gap-2">

            <%= f.radio_button :work_mode, "flex" %>

            <span><%= t("users.work_mode_flex") %></span>

          </label>

        </div>

      </div>

      <% if @user.work_mode == "fixed" %>
        <!-- Fixed Times -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div>

            <%= f.label :fixed_start_time,
                t("users.fixed_start"),
                class: "block text-sm font-medium
                        text-slate-700 mb-2" %>

            <%= f.time_field :fixed_start_time,
                class: "
                  w-full rounded-2xl border border-slate-300
                  px-4 py-3
                " %>

          </div>

          <div>

            <%= f.label :fixed_end_time,
                t("users.fixed_end"),
                class: "block text-sm font-medium
                        text-slate-700 mb-2" %>

            <%= f.time_field :fixed_end_time,
                class: "
                  w-full rounded-2xl border border-slate-300
                  px-4 py-3
                " %>

          </div>

        </div>
      <% end %>

      <!-- Locale -->
      <div>

        <%= f.label :preferred_locale,
          t("users.language"),
            class: "block text-sm font-medium
                    text-slate-700 mb-2" %>

        <%= f.select :preferred_locale,
            [
              [t("users.language_en"), "en"],
              [t("users.language_ja"), "ja"]
            ],
            {},
            class: "
              w-full rounded-2xl border border-slate-300
              px-4 py-3
            " %>

      </div>

      <!-- Submit -->
      <div>

        <%= f.submit t("users.save"),
            class: "
              bg-slate-800 hover:bg-slate-900
              text-white px-6 py-3 rounded-2xl
              font-semibold transition
            " %>

      </div>

    <% end %>

  </div>

  <div class="bg-white border border-slate-200
              rounded-3xl shadow-sm p-8 mt-8">

    <h2 class="text-xl font-semibold text-slate-800">
      <%= t("users.change_password") %>
    </h2>

    <p class="text-slate-500 mt-2">
      <%= link_to t("users.change_password_action"),
          edit_user_registration_path,
          class: "text-emerald-600 hover:text-emerald-700 font-medium" %>
    </p>

  </div>

</div>