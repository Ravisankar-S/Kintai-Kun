<div class="max-w-6xl mx-auto py-10 px-4">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">
      <%= t("work_logs.title") %>
    </h1>

    <div class="flex items-center gap-3">
      <%= form_with url: work_logs_path,
          method: :get,
          class: "flex items-center gap-2",
          local: true do %>

        <%= select_tag :month,
            options_for_select(
              @month_options.map do |date|
                [l(date, format: :month_year), date.strftime("%Y-%m")]
              end,
              @month.strftime("%Y-%m")
            ),
            class: "
              rounded-xl border border-slate-300
              px-3 py-2 text-sm
              focus:outline-none focus:ring-2
              focus:ring-emerald-400
            ",
            onchange: "this.form.submit()" %>
      <% end %>

      <%= link_to t("work_logs.export_csv"),
        export_csv_work_logs_path(
          format: :csv,
          month: @month.strftime("%Y-%m")
        ),
        class: "
          bg-slate-800 hover:bg-slate-900
          text-white px-4 py-2 rounded-xl
          text-sm font-medium
        " %>
    </div>
  </div>

  <div class="bg-white border rounded-2xl shadow-sm overflow-hidden">

    <% if @work_logs.empty? %>

      <div class="bg-white border border-slate-200
                  rounded-3xl p-10 text-center shadow-sm">

        <p class="text-slate-500 text-lg">
          <%= t("work_logs.no_logs") %>
        </p>

      </div>

    <% else %>

    <table class="w-full">

      <thead class="bg-slate-100">
        <tr>
          <th class="text-left p-4"><%= t("work_logs.date") %></th>
          <th class="text-left p-4"><%= t("work_logs.clock_in") %></th>
          <th class="text-left p-4"><%= t("work_logs.clock_out") %></th>
          <th class="text-left p-4"><%= t("work_logs.duration") %></th>
          <th class="text-left p-4"><%= t("work_logs.memo") %></th>
          <th class="text-left p-4"><%= t("work_logs.overtime") %></th>
        </tr>
      </thead>

      <tbody>

        <% @work_logs.each do |log| %>

          <tr class="border-t <%= log.is_overtime ? 'bg-amber-50' : '' %>">

            <td class="p-4">
              <%= l(log.clocked_in_at.to_date, format: :table) %>
            </td>

            <td class="p-4">
              <%= l(log.clocked_in_at, format: :clock) %>
            </td>

            <td class="p-4">
              <% if log.clocked_out_at.present? %>
                <%= l(log.clocked_out_at, format: :clock) %>
              <% else %>
                <span class="text-slate-400 italic">—</span>
              <% end %>
            </td>

            <td class="p-4">
              <% if log.duration_minutes %>
                <%= minutes_to_hm(log.duration_minutes) %>
              <% else %>
                <span class="text-slate-400 italic">—</span>
              <% end %>
            </td>

            <%# Added Memo Data Cell %>
            <td class="px-4 py-3 text-sm text-slate-600">
              <%= log.memo.presence || "—" %>
            </td>

            <td class="p-4">
              <% if log.is_overtime %>
                <span class="text-red-500 font-semibold">
                  <%= t("work_logs.overtime") %>
                </span>
              <% else %>
                —
              <% end %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

    <div class="px-4 py-4">
      <%= paginate @work_logs %>
    </div>

    <% end %>

  </div>

</div>