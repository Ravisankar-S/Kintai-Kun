<%# Work Log History – exact replica of design reference %>

<div class="max-w-5xl mx-auto py-10 px-4">

  <%# ── Page Header Row ── %>
  <div class="flex items-start justify-between mb-1">

    <%# Title block %>
    <div>
      <h1 class="text-[32px] leading-tight text-[#1A1A18]"
          style="font-family: 'DM Serif Display', serif;">
        <%= t('work_logs.title') %>
      </h1>
    </div>

    <%# Controls: month filter + CSV %>
    <div class="flex items-center gap-3 mt-1">

      <%# ── Custom month-filter dropdown (Stimulus) ── %>
      <div data-controller="month-filter" class="relative">

        <button
          data-month-filter-target="trigger"
          data-action="click->month-filter#toggle"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex items-center gap-2 h-9 px-4 rounded-lg
                 border border-[#E8E6E1] bg-[#F0EEE9]
                 text-[14px] text-[#1A1A18] hover:bg-[#E8E5DF]
                 transition-colors duration-100 select-none"
          style="font-family: 'Geist', 'Inter', sans-serif;">
          <%= @month.strftime('%B %Y') %>
          <svg class="w-3.5 h-3.5 text-[#6B6860]" viewBox="0 0 16 16"
               fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <%# Dropdown list %>
        <div
          data-month-filter-target="dropdown"
          class="hidden absolute right-0 top-[calc(100%+6px)] z-50 min-w-[160px]
                 rounded-xl border border-[#E8E6E1] bg-white
                 overflow-hidden
                 opacity-0 -translate-y-1
                 transition-[opacity,transform] duration-150 ease-out"
          role="listbox">
          <% @month_options.each do |m| %>
            <% is_active = (m.year == @month.year && m.month == @month.month) %>
            <%= link_to work_logs_path(month: m.strftime('%Y-%m')),
                class: [
                  "flex items-center px-4 py-2.5 text-[13px] text-[#1A1A18]",
                  "hover:bg-[#F7F6F3] transition-colors duration-75",
                  is_active ? "border-l-[3px] border-l-[#2D6A4F] pl-[13px] font-medium" : "border-l-[3px] border-l-transparent"
                ].join(" "),
                style: "font-family: 'Geist', 'Inter', sans-serif;" do %>
              <%= m.strftime('%B %Y') %>
            <% end %>
          <% end %>
        </div>

      </div><%# /month-filter %>

      <%# CSV export button %>
      <%= link_to export_csv_work_logs_path(format: :csv, month: @month.strftime('%Y-%m')),
          data: { turbo: false },
          class: "flex items-center gap-2 h-9 px-4 rounded-lg
                  border border-[#E8E6E1] bg-[#F0EEE9]
                  text-[14px] text-[#1A1A18] hover:bg-[#E8E5DF]
                  transition-colors duration-100",
          style: "font-family: 'Geist', 'Inter', sans-serif;" do %>
        <%# Inline SVG: download arrow %>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"
             stroke="currentColor" stroke-width="1.75"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 1v8M4 6l3 3 3-3"/>
          <path d="M1 10v1.5A1.5 1.5 0 0 0 2.5 13h9A1.5 1.5 0 0 0 13 11.5V10"/>
        </svg>
        <%= t('work_logs.export_csv') %>
      <% end %>

    </div>
  </div>

  <%# ── Stats line ── %>
  <p class="text-[13px] text-[#6B6860] mt-4 mb-5"
     style="font-family: 'Geist', 'Inter', sans-serif;">
    <%= @work_logs.total_count %> records ·
    <span class="text-[#D4830A] font-medium">
      <%= @work_logs.select(&:is_overtime).count %> overtime
    </span>
    · <%= minutes_to_hm(@work_logs.sum(:duration_minutes)) %> total
  </p>

  <%# ── Table wrapper ── %>
  <div class="rounded-2xl overflow-hidden border border-[#E8E6E1] bg-white shadow-sm">

    <table class="w-full border-collapse">

      <%# THEAD %>
      <thead>
        <tr class="bg-[#F7F6F3] border-b border-[#E8E6E1]">
          <th class="py-3 px-4 w-[16%] text-left text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.date') %>
          </th>
          <th class="py-3 px-4 w-[12%] text-left text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.clock_in') %>
          </th>
          <th class="py-3 px-4 w-[12%] text-left text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.clock_out') %>
          </th>
          <th class="py-3 px-4 w-[13%] text-left text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.duration') %>
          </th>
          <th class="py-3 px-4 w-[39%] text-left text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.memo') %>
          </th>
          <th class="py-3 px-4 w-[8%] text-right text-[11px] tracking-[0.08em]
                     uppercase text-[#6B6860] font-medium"
              style="font-family: 'Geist', 'Inter', sans-serif;">
            <%= t('work_logs.overtime') %>
          </th>
        </tr>
      </thead>

      <tbody>
        <% if @work_logs.empty? %>
          <%# Empty state %>
          <tr>
            <td colspan="6" class="py-20 text-center">
              <%# Minimal clock SVG %>
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none"
                   stroke="#2D6A4F" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round"
                   class="mx-auto">
                <circle cx="32" cy="32" r="26"/>
                <path d="M32 18v14l8 8"/>
              </svg>
              <p class="mt-4 text-[22px] text-[#1A1A18]"
                 style="font-family: 'Shippori Mincho', serif; font-weight: 500;">
                <%= t('work_logs.no_logs') %>
              </p>
            </td>
          </tr>

        <% else %>
          <% @work_logs.each_with_index do |log, index| %>
            <%
              is_active   = log.clocked_out_at.nil?
              is_overtime = log.is_overtime
              row_classes = [
                "h-14 border-b border-[#F0EEE9] transition-colors duration-75",
                is_active   ? "bg-[#F5FAF7] border-l-[3px] border-l-[#2D6A4F] hover:bg-[#EEF8F2]"
                            : (is_overtime ? "bg-[#FFFBF5] hover:bg-[#FEF7EC]"
                                           : "hover:bg-[#FAFAF8]")
              ].join(" ")
            %>
            <tr class="<%= row_classes %>"
                style="animation: rowReveal 200ms ease forwards; animation-delay: <%= index * 20 %>ms; opacity: 0;">

              <%# DATE cell %>
              <td class="py-0 px-4">
                <div class="flex flex-col leading-tight"
                     style="font-family: 'Geist', 'Inter', sans-serif;">
                  <span class="text-[18px] font-semibold text-[#1A1A18] leading-none">
                    <%= log.clocked_in_at.strftime('%-d') %>
                  </span>
                  <span class="text-[11px] text-[#A8A49E] mt-0.5">
                    <%= log.clocked_in_at.strftime('%a') %>
                  </span>
                </div>
              </td>

              <%# IN cell %>
              <td class="py-0 px-4">
                <div class="flex items-center"
                     style="font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 14px; color: #1A1A18;">
                  <% if is_active %>
                    <span class="inline-block w-2 h-2 rounded-full bg-[#2D6A4F] mr-2
                                 animate-[pulse_2s_ease-in-out_infinite]"></span>
                  <% end %>
                  <%= log.clocked_in_at.strftime('%H:%M') %>
                </div>
              </td>

              <%# OUT cell %>
              <td class="py-0 px-4">
                <% if log.clocked_out_at.present? %>
                  <span style="font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 14px; color: #1A1A18;">
                    <%= log.clocked_out_at.strftime('%H:%M') %>
                  </span>
                <% else %>
                  <span class="italic text-[14px] text-[#A8A49E]">—</span>
                <% end %>
              </td>

              <%# TIME cell %>
              <td class="py-0 px-4">
                <% if log.clocked_out_at.present? && log.duration_minutes %>
                  <span class="font-semibold text-[14px]
                               <%= is_overtime ? 'text-[#D4830A]' : 'text-[#1A1A18]' %>"
                        style="font-family: 'JetBrains Mono', 'Fira Code', monospace;">
                    <%= minutes_to_hm(log.duration_minutes) %>
                  </span>
                <% else %>
                  <span class="italic text-[14px] text-[#A8A49E]">—</span>
                <% end %>
              </td>

              <%# MEMO cell – with Stimulus tooltip %>
              <td class="py-0 px-4 max-w-0 w-full">
                <% if log.memo.present? %>
                  <div
                    data-controller="tooltip"
                    data-tooltip-content-value="<%= log.memo %>"
                    class="truncate text-[13px] text-[#6B6860]"
                    style="font-family: 'Geist', 'Inter', sans-serif;">
                    <%= log.memo %>
                  </div>
                <% end %>
              </td>

              <%# OT cell %>
              <td class="py-0 px-4 text-right">
                <% if is_overtime %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full
                               text-[11px] font-medium bg-[#FEF0E0] text-[#92620A]"
                        style="font-family: 'Geist', 'Inter', sans-serif;">
                    残業
                  </span>
                <% end %>
              </td>

            </tr>
          <% end %>
        <% end %>
      </tbody>

    </table>

    <%# Pagination – rendered inline using @work_logs kaminari methods directly,
        avoiding the _paginator.html.erb partial API mismatch. %>
    <% if @work_logs.total_pages > 1 %>
      <nav class="flex items-center justify-center gap-6 py-6"
           aria-label="Pagination"
           style="font-family: 'Geist', 'Inter', sans-serif; font-size: 13px; color: #6B6860;">

        <%# ← Previous %>
        <% if @work_logs.first_page? %>
          <span class="text-[#C8C5BE] pointer-events-none select-none">← Previous</span>
        <% else %>
          <%= link_to "← Previous",
              work_logs_path(page: @work_logs.current_page - 1, month: @month.strftime('%Y-%m')),
              class: "text-[#6B6860] hover:text-[#2D6A4F] transition-colors duration-100" %>
        <% end %>

        <%# Page X of Y %>
        <span class="text-[#6B6860]">
          Page
          <span class="font-semibold text-[#1A1A18]"><%= @work_logs.current_page %></span>
          of <%= @work_logs.total_pages %>
        </span>

        <%# Next → %>
        <% if @work_logs.last_page? %>
          <span class="text-[#C8C5BE] pointer-events-none select-none">Next →</span>
        <% else %>
          <%= link_to "Next →",
              work_logs_path(page: @work_logs.current_page + 1, month: @month.strftime('%Y-%m')),
              class: "text-[#6B6860] hover:text-[#2D6A4F] transition-colors duration-100" %>
        <% end %>

      </nav>
    <% end %>

  </div><%# /table wrapper %>

</div>