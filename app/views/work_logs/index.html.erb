<div class="max-w-6xl mx-auto py-10 px-4">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">
      <%= t("work_logs.title") %>
    </h1>

    <%= link_to "Download CSV",
      export_csv_work_logs_path(format: :csv),
      class: "
        bg-slate-800 hover:bg-slate-900
        text-white px-4 py-2 rounded-xl
        text-sm font-medium
      " %>
  </div>

  <div class="bg-white border rounded-2xl shadow-sm overflow-hidden">

    <% if @work_logs.empty? %>

      <div class="bg-white border border-slate-200
                  rounded-3xl p-10 text-center shadow-sm">

        <p class="text-slate-500 text-lg">
          <%= t("work_logs.empty_title") %>
        </p>
        <p class="text-slate-400 text-sm mt-2">
          <%= t("work_logs.empty_body") %>
        </p>

      </div>

    <% else %>

    <table class="w-full">

      <thead class="bg-slate-100">
        <tr>
          <th class="text-left p-4"><%= t("work_logs.table.date") %></th>
          <th class="text-left p-4"><%= t("work_logs.table.clock_in") %></th>
          <th class="text-left p-4"><%= t("work_logs.table.clock_out") %></th>
          <th class="text-left p-4"><%= t("work_logs.table.duration") %></th>
          <th class="text-left p-4"><%= t("work_logs.table.overtime") %></th>
          <%# Added Memo Header %>
          <th class="text-left p-4"><%= t("work_logs.table.memo") %></th>
        </tr>
      </thead>

      <tbody>

        <% @work_logs.each do |log| %>

          <tr class="border-t">

            <td class="p-4">
              <%= l(log.clocked_in_at.to_date, format: :table) %>
            </td>

            <td class="p-4">
              <%= l(log.clocked_in_at, format: :clock) %>
            </td>

            <td class="p-4">
              <% if log.clocked_out_at.present? %>
                <%= l(log.clocked_out_at, format: :clock) %>
              <% else %>
                —
              <% end %>
            </td>

            <td class="p-4">
              <% if log.duration_minutes %>
                <%= (log.duration_minutes / 60.0).round(2) %>
                <%= t("work_logs.hours_short") %>
              <% else %>
                —
              <% end %>
            </td>

            <td class="p-4">
              <% if log.is_overtime %>
                <span class="text-red-500 font-semibold">
                  <%= t("work_logs.overtime_short") %>
                </span>
              <% else %>
                —
              <% end %>
            </td>

            <%# Added Memo Data Cell %>
            <td class="px-4 py-3 text-sm text-slate-600">
              <%= log.memo.presence || "—" %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

    <% end %>

  </div>

</div>